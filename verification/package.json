{
  "name": "codex-router-release-verification",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:tooling": "node --test tooling/tests/*.test.ts",
    "test:fixtures": "node --test fixtures/tests/*.test.ts",
    "test:observations": "node --test observations/tests/*.test.ts",
    "test": "node --test tooling/tests/*.test.ts fixtures/tests/*.test.ts observations/tests/*.test.ts"
  },
  "dependencies": {
    "lossless-json": "4.3.3",
    "miniflare": "5.20261012.0-beta",
    "smol-toml": "1.9.1",
    "workerd": "1.20261012.1",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.11.1"
  },
  "packageManager": "pnpm@12.14.0"
}
