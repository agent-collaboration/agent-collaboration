{
  "name": "codex-router-release-verification",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && pnpm run check:behavior-peer",
    "check:behavior-peer": "tsc --noEmit -p tsconfig.behavior-peer.json",
    "lint": "oxlint --deny-warnings . \"${PWD%/*}/crates/acp-client-runtime/tests/support/behavior-agent.ts\" \"${PWD%/*}/crates/acp-client-runtime/tests/support/behavior-agent.test.ts\"",
    "format": "oxfmt . \"${PWD%/*}/crates/acp-client-runtime/tests/support/behavior-agent.ts\" \"${PWD%/*}/crates/acp-client-runtime/tests/support/behavior-agent.test.ts\"",
    "format:check": "oxfmt --check . \"${PWD%/*}/crates/acp-client-runtime/tests/support/behavior-agent.ts\" \"${PWD%/*}/crates/acp-client-runtime/tests/support/behavior-agent.test.ts\"",
    "test:tooling": "node --test \"tooling/**/*.test.ts\"",
    "test:fixtures": "node --test \"fixtures/**/*.test.ts\"",
    "test:observations": "node --test \"observations/**/*.test.ts\"",
    "test": "node --test \"*.test.ts\" \"tooling/**/*.test.ts\" \"fixtures/**/*.test.ts\" \"observations/**/*.test.ts\" \"access/**/*.test.ts\" \"clients/**/*.test.ts\" \"machines/**/*.test.ts\"",
    "test:workerd": "node --test \"targets/**/*.test.ts\""
  },
  "dependencies": {
    "lossless-json": "4.3.3",
    "miniflare": "5.20261012.0-beta",
    "smol-toml": "1.9.1",
    "workerd": "1.20261012.1",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.11.1"
  },
  "packageManager": "pnpm@12.14.0"
}
