{
  "db_name": "Turso",
  "query": "SELECT p.thread_id AS \"thread_id!: String\", p.participation_id AS \"participation_id!: String\", p.actor_id AS \"reader_actor!: String\", a.canonical_identity AS \"reader_identity?: String\", p.role AS \"role!: String\", p.joined_epoch AS \"joined_epoch!: i64\", p.joined_position AS \"joined_position!: i64\", p.last_seen_epoch AS \"last_seen_epoch!: i64\", p.last_seen_position AS \"last_seen_position!: i64\", p.closed_position AS \"closed_position?: i64\", p.closed_reason AS \"closed_reason?: String\", p.replaced_by AS \"replaced_by?: String\" FROM thread_participation p LEFT JOIN actors a ON a.actor_id=p.actor_id WHERE p.thread_id IN (SELECT value FROM json_each(?)) AND p.closed_epoch IS NULL AND p.role IN ('orchestrator', 'implementer') ORDER BY p.thread_id, p.role, p.participation_id",
