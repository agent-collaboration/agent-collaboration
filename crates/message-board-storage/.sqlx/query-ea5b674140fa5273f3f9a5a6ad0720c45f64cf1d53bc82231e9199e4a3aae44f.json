  "query": "SELECT p.reader AS \"reader!: String\", p.joined_epoch AS \"joined_epoch!: i64\", p.joined_position AS \"joined_position!: i64\", p.role AS \"role!: String\", p.active AS \"active!: i64\", p.payload AS \"payload!: String\" FROM json_each(?) k CROSS JOIN thread_participants p ON p.reader = CAST(json_extract(k.value, '$[0]') AS TEXT) AND p.thread_id = ? AND p.joined_epoch = json_extract(k.value, '$[1]') AND p.joined_position = json_extract(k.value, '$[2]')",
