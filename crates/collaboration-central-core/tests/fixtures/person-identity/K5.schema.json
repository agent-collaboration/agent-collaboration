{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"oneOf": [
		{
			"type": "object",
			"properties": {
				"active": {
					"type": "boolean",
					"const": false
				}
			},
			"required": ["active"],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"active": {
					"type": "boolean",
					"const": true
				},
				"sub": {
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
				},
				"sid": {
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
				},
				"aud": {
					"type": "string",
					"format": "uri",
					"description": "Exactly one relying-service audience; arrays are refused"
				},
				"exp": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991,
					"description": "Seconds since the Unix epoch"
				},
				"organization_id": {
					"type": "string",
					"format": "uuid",
					"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
				},
				"checkedAt": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991,
					"description": "Milliseconds since the Unix epoch at the first session read"
				}
			},
			"required": ["active", "sub", "sid", "aud", "exp", "organization_id", "checkedAt"],
			"additionalProperties": {}
		}
	]
}
