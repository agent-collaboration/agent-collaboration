        "personId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "standing",
          "type": "string"
        },
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        },
        "personId": {
          "$ref": "#/$defs/PersonId"
        }
      },
      "required": [
        "operation",
        "organizationId",
        "personId"
      ],
      "type": "object"
    }
  ],
  "title": "PersonAdmissionRequest"
}
