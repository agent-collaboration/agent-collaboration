{
  "$defs": {
    "EnrollmentId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "MachineTokenRefusal": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "enrollmentNotActive",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "superseded",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wrongClient",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "idleExpired",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "UnixSeconds": {
      "format": "int64",
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "decidedAt": {
          "$ref": "#/$defs/UnixSeconds"
        },
        "enrollmentId": {
          "$ref": "#/$defs/EnrollmentId"
        },
        "grantExpiresAt": {
          "$ref": "#/$defs/UnixSeconds"
        },
        "installation": {
          "$ref": "#/$defs/InstallationId"
        },
        "result": {
          "const": "grant",
          "type": "string"
        }
      },
      "required": [
        "result",
        "installation",
        "enrollmentId",
        "decidedAt",
        "grantExpiresAt"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/MachineTokenRefusal"
        },
        "result": {
          "const": "refuse",
          "type": "string"
        }
      },
      "required": [
        "result",
        "reason"
      ],
      "type": "object"
    }
  ],
  "title": "MachineTokenDecision"
}
