{
  "$defs": {
    "ConnectionView": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "lastHeardAt": {
              "$ref": "#/$defs/UnixMillis"
            },
            "since": {
              "$ref": "#/$defs/UnixMillis"
            },
            "state": {
              "const": "connected",
              "type": "string"
            }
          },
          "required": [
            "state",
            "since",
            "lastHeardAt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "lastSeenAt": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UnixMillis"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "const": "notConnected",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "EndpointId": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string",
      "x-maxUtf8Bytes": 64
    },
    "EnrollmentView": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "approvedAt": {
              "$ref": "#/$defs/UnixMillis"
            },
            "approvedBy": {
              "$ref": "#/$defs/PersonId"
            },
            "state": {
              "const": "enrolled",
              "type": "string"
            }
          },
          "required": [
            "state",
            "approvedBy",
            "approvedAt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "approvedAt": {
              "$ref": "#/$defs/UnixMillis"
            },
            "approvedBy": {
              "$ref": "#/$defs/PersonId"
            },
            "state": {
              "const": "revoked",
              "type": "string"
            }
          },
          "required": [
            "state",
            "approvedBy",
            "approvedAt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "approvedAt": {
              "$ref": "#/$defs/UnixMillis"
            },
            "approvedBy": {
              "$ref": "#/$defs/PersonId"
            },
            "state": {
              "const": "expired",
              "type": "string"
            }
          },
          "required": [
            "state",
            "approvedBy",
            "approvedAt"
          ],
          "type": "object"
        }
      ]
    },
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "IsolationKind": {
      "enum": [
        "host",
        "processSandbox",
        "container",
        "vm"
      ],
      "type": "string"
    },
    "MachineLabel": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "PersonId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ProjectId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/ResourceName"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "projectId",
        "name"
      ],
      "type": "object"
    },
    "ResourceName": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "ServiceId": {
      "maxLength": 36,
      "minLength": 36,
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "SessionEndpointRef": {
      "additionalProperties": false,
      "properties": {
        "endpointId": {
          "$ref": "#/$defs/EndpointId"
        },
        "serviceId": {
          "$ref": "#/$defs/ServiceId"
        }
      },
      "required": [
        "serviceId",
        "endpointId"
      ],
      "type": "object"
    },
    "SessionId": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string",
      "x-maxUtf8Bytes": 4096
    },
    "SessionRef": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/SessionEndpointRef"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "endpoint",
        "sessionId"
      ],
      "type": "object"
    },
    "SessionRow": {
      "additionalProperties": false,
      "properties": {
        "isolationKind": {
          "$ref": "#/$defs/IsolationKind"
        },
        "project": {
          "$ref": "#/$defs/ProjectRef"
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "startedAt": {
          "$ref": "#/$defs/UnixMillis"
        },
        "state": {
          "$ref": "#/$defs/SessionStateView"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceRef"
        }
      },
      "required": [
        "session",
        "project",
        "workspace",
        "isolationKind",
        "startedAt",
        "state"
      ],
      "type": "object"
    },
    "SessionStateView": {
      "enum": [
        "working",
        "idle",
        "unknown"
      ],
      "type": "string"
    },
    "UnixMillis": {
      "format": "int64",
      "type": "integer"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/ResourceName"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connection": {
      "$ref": "#/$defs/ConnectionView"
    },
    "enrollment": {
      "$ref": "#/$defs/EnrollmentView"
    },
    "installation": {
      "$ref": "#/$defs/InstallationId"
    },
    "label": {
      "$ref": "#/$defs/MachineLabel"
    },
    "mayServe": {
      "items": {
        "$ref": "#/$defs/WorkspaceRef"
      },
      "type": "array"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/SessionRow"
      },
      "type": "array"
    }
  },
  "required": [
    "installation",
    "label",
    "enrollment",
    "mayServe",
    "connection",
    "sessions"
  ],
  "title": "MachineRow",
  "type": "object"
}
