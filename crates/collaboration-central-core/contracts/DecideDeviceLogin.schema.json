{
  "$defs": {
    "AllowedWorkspaces": {
      "items": {
        "$ref": "#/$defs/WorkspaceId"
      },
      "maxItems": 100,
      "type": "array"
    },
    "DeviceLoginRequestId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "EnrollPermission": {
      "enum": [
        "machine:enroll"
      ],
      "type": "string"
    },
    "MachineId": {
      "description": "The Router install's durable identity, shared with central.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "MachineLabel": {
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$(?![\\s\\S])"
        }
      ],
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?:[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)?$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "OrganizationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "PersonId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "UnixSeconds": {
      "format": "int64",
      "type": "integer"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedWorkspaces": {
      "$ref": "#/$defs/AllowedWorkspaces"
    },
    "approver": {
      "$ref": "#/$defs/PersonId"
    },
    "approverSecondFactorAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnixSeconds"
        },
        {
          "type": "null"
        }
      ],
      "minimum": 0
    },
    "codeExpiresAt": {
      "$ref": "#/$defs/UnixSeconds",
      "minimum": 0
    },
    "label": {
      "$ref": "#/$defs/MachineLabel"
    },
    "machineId": {
      "$ref": "#/$defs/MachineId"
    },
    "organizationId": {
      "$ref": "#/$defs/OrganizationId"
    },
    "permissionChecked": {
      "$ref": "#/$defs/EnrollPermission"
    },
    "requestId": {
      "$ref": "#/$defs/DeviceLoginRequestId"
    }
  },
  "required": [
    "organizationId",
    "approver",
    "permissionChecked",
    "requestId",
    "machineId",
    "label",
    "allowedWorkspaces",
    "approverSecondFactorAt",
    "codeExpiresAt"
  ],
  "title": "DecideDeviceLogin",
  "type": "object"
}
