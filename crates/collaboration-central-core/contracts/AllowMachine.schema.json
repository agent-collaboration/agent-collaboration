{
  "$defs": {
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "OrganizationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "installation": {
      "$ref": "#/$defs/InstallationId"
    },
    "organizationId": {
      "$ref": "#/$defs/OrganizationId"
    },
    "workspaceId": {
      "$ref": "#/$defs/WorkspaceId"
    }
  },
  "required": [
    "organizationId",
    "installation",
    "workspaceId"
  ],
  "title": "AllowMachine",
  "type": "object"
}
