{
  "$defs": {
    "EnrollmentId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "MachinePrincipal": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "enrollment_id": {
              "$ref": "#/$defs/EnrollmentId"
            },
            "installation_id": {
              "$ref": "#/$defs/InstallationId"
            },
            "kind": {
              "const": "machine",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "installation_id",
            "enrollment_id"
          ],
          "type": "object"
        }
      ]
    },
    "OrganizationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "UnixSeconds": {
      "format": "int64",
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Only extension claims live here; the token checker validates the registered claims separately.",
  "properties": {
    "grant_expires_at": {
      "$ref": "#/$defs/UnixSeconds"
    },
    "organization_id": {
      "$ref": "#/$defs/OrganizationId"
    },
    "principal": {
      "$ref": "#/$defs/MachinePrincipal"
    }
  },
  "required": [
    "principal",
    "organization_id",
    "grant_expires_at"
  ],
  "title": "MachineTokenClaims",
  "type": "object"
}
