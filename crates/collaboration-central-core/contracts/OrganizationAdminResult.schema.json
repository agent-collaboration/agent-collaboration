{
  "$defs": {
    "AdminRefusal": {
      "oneOf": [
        {
          "enum": [
            "nameInUse",
            "notPermitted",
            "secondFactorRequired",
            "refreshRequired",
            "authorizationSyncRequired",
            "expired",
            "requestTime",
            "requestReused",
            "rejected"
          ],
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "The same operation ID arrived with a different request.",
          "type": "string"
        },
        {
          "const": "notFound",
          "description": "No failure record has this attempt ID (or a concurrent retry took it).",
          "type": "string"
        },
        {
          "const": "notRetired",
          "description": "The record is failing, not retired.",
          "type": "string"
        },
        {
          "const": "discardUnsupported",
          "description": "A notice unit or engine_source record has no subject to finish.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "The subject moved; nothing changed.",
          "type": "string"
        }
      ]
    },
    "ChangeRequestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "EngineFailureClass": {
      "description": "The closed failure classes of central_work_attempts.last_failure.",
      "enum": [
        "corrupt_row",
        "constraint_violated",
        "statement_rejected",
        "refused",
        "other_store_unavailable"
      ],
      "type": "string"
    },
    "EngineKindHealth": {
      "additionalProperties": false,
      "description": "One registered engine kind in EngineHealth; zero counts are listed too.",
      "properties": {
        "failing": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/EngineKindName"
        },
        "lastFailure": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineFailureClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "oldestFirstFailedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "retired": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "failing",
        "retired",
        "oldestFirstFailedAt",
        "lastFailure"
      ],
      "type": "object"
    },
    "EngineKindName": {
      "description": "The closed set of engine kinds an admin sees; test-support machines are hidden.",
      "enum": [
        "wake_timer",
        "automation_timer",
        "legacy_notice_windows",
        "legacy_workspace_drains",
        "engine_source"
      ],
      "type": "string"
    },
    "EngineRetiredItem": {
      "additionalProperties": false,
      "description": "One retired failure record in EngineListRetired, ascending by attempt ID.",
      "properties": {
        "attemptId": {
          "format": "uuid",
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "failureClass": {
          "$ref": "#/$defs/EngineFailureClass"
        },
        "kind": {
          "$ref": "#/$defs/EngineKindName"
        },
        "lastFailure": {
          "type": [
            "string",
            "null"
          ]
        },
        "retiredAt": {
          "format": "date-time",
          "type": "string"
        },
        "subjectKey": {
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "kind",
        "subjectKey",
        "failureClass",
        "count",
        "retiredAt",
        "lastFailure"
      ],
      "type": "object"
    },
    "OrganizationChangeKind": {
      "enum": [
        "organizationProvisioned",
        "stampRenewed",
        "workspaceCreated",
        "machineEnrolled",
        "machineRevoked",
        "machineExpired",
        "allowanceChanged"
      ],
      "type": "string"
    },
    "OrganizationChangeOrigin": {
      "description": "A sign-in-originated change carries no person or permission; none is invented.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "An empty struct variant so an unknown field is refused like any other.",
          "properties": {
            "kind": {
              "const": "signInProvisioning",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "automatic",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "person",
              "type": "string"
            },
            "permissionChecked": {
              "type": "string"
            },
            "personId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "personId",
            "permissionChecked"
          ],
          "type": "object"
        }
      ]
    },
    "OrganizationChangeRecord": {
      "additionalProperties": false,
      "properties": {
        "createdAtMillis": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OrganizationChangeKind"
        },
        "origin": {
          "$ref": "#/$defs/OrganizationChangeOrigin"
        },
        "requestId": {
          "$ref": "#/$defs/ChangeRequestId"
        },
        "targetId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "requestId",
        "kind",
        "origin",
        "targetId",
        "createdAtMillis"
      ],
      "type": "object"
    },
    "ResourceName": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?:[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)?$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceState": {
      "enum": [
        "active",
        "archiving",
        "archived"
      ],
      "type": "string"
    },
    "WorkspaceView": {
      "additionalProperties": false,
      "description": "The verified admin view of the org-owned workspace directory.",
      "properties": {
        "description": {
          "maxLength": 2048,
          "type": "string",
          "x-maxUtf8Bytes": 2048
        },
        "name": {
          "$ref": "#/$defs/ResourceName"
        },
        "state": {
          "$ref": "#/$defs/WorkspaceState"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "name",
        "description",
        "state"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The closed body of a 200 on an admin route.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "result": {
          "const": "applied",
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceView"
        }
      },
      "required": [
        "result",
        "workspace"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "result": {
          "const": "found",
          "type": "string"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "result",
        "workspace"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "records": {
          "items": {
            "$ref": "#/$defs/OrganizationChangeRecord"
          },
          "type": "array"
        },
        "result": {
          "const": "records",
          "type": "string"
        }
      },
      "required": [
        "result",
        "records"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "alarm": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "alarmMissing": {
          "type": "boolean"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/EngineKindHealth"
          },
          "type": "array"
        },
        "result": {
          "const": "engineHealth",
          "type": "string"
        }
      },
      "required": [
        "result",
        "kinds",
        "alarm",
        "alarmMissing"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/EngineRetiredItem"
          },
          "type": "array"
        },
        "next": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "const": "engineRetired",
          "type": "string"
        }
      },
      "required": [
        "result",
        "items",
        "next"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "result": {
          "const": "engineRetried",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "result": {
          "const": "engineDiscarded",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/AdminRefusal"
        },
        "result": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "result",
        "reason"
      ],
      "type": "object"
    }
  ],
  "title": "OrganizationAdminResult"
}
