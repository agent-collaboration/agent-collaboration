{
  "$defs": {
    "AllowedWorkspaces": {
      "items": {
        "$ref": "#/$defs/WorkspaceId"
      },
      "maxItems": 100,
      "type": "array"
    },
    "DeviceLoginRefusal": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notPermitted",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "machineInAnotherOrganization",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknownWorkspace",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "secondFactorRequired",
              "type": "string"
            },
            "withinSeconds": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "withinSeconds"
          ],
          "type": "object"
        }
      ]
    },
    "EnrollmentId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "MachineLabel": {
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$(?![\\s\\S])"
        }
      ],
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?:[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)?$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "allowedWorkspaces": {
          "$ref": "#/$defs/AllowedWorkspaces"
        },
        "enrollmentId": {
          "$ref": "#/$defs/EnrollmentId"
        },
        "label": {
          "$ref": "#/$defs/MachineLabel"
        },
        "result": {
          "const": "approved",
          "type": "string"
        }
      },
      "required": [
        "result",
        "enrollmentId",
        "label",
        "allowedWorkspaces"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/DeviceLoginRefusal"
        },
        "result": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "result",
        "reason"
      ],
      "type": "object"
    }
  ],
  "title": "DeviceLoginDecision"
}
