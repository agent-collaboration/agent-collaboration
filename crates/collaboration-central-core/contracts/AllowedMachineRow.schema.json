{
  "$defs": {
    "MachineId": {
      "description": "The Router install's durable identity, shared with central.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "MachineLabel": {
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$(?![\\s\\S])"
        }
      ],
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?:[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)?$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "label": {
      "$ref": "#/$defs/MachineLabel"
    },
    "machineId": {
      "$ref": "#/$defs/MachineId"
    }
  },
  "required": [
    "machineId",
    "label"
  ],
  "title": "AllowedMachineRow",
  "type": "object"
}
