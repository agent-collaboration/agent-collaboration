{
  "$defs": {
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "MachineLabel": {
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f]*$(?![\\s\\S])"
        }
      ],
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?:[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)?$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "installation": {
      "$ref": "#/$defs/InstallationId"
    },
    "label": {
      "$ref": "#/$defs/MachineLabel"
    }
  },
  "required": [
    "installation",
    "label"
  ],
  "title": "AllowedMachineRow",
  "type": "object"
}
