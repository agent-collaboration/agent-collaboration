{
  "$defs": {
    "AllowanceState": {
      "enum": [
        "active",
        "withdrawn"
      ],
      "type": "string"
    },
    "MachineId": {
      "description": "The Router install's durable identity, shared with central.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "machineId": {
      "$ref": "#/$defs/MachineId"
    },
    "state": {
      "$ref": "#/$defs/AllowanceState"
    },
    "workspaceId": {
      "$ref": "#/$defs/WorkspaceId"
    }
  },
  "required": [
    "machineId",
    "workspaceId",
    "state"
  ],
  "title": "MachineAllowance",
  "type": "object"
}
