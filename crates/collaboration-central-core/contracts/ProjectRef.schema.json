{
  "$defs": {
    "ProjectId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ResourceName": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-maxUtf8Bytes": 256
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "#/$defs/ResourceName"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    }
  },
  "required": [
    "projectId",
    "name"
  ],
  "title": "ProjectRef",
  "type": "object"
}
