{
  "$defs": {
    "AdmittedMachine": {
      "additionalProperties": false,
      "properties": {
        "enrollmentId": {
          "$ref": "#/$defs/EnrollmentId"
        },
        "installation": {
          "$ref": "#/$defs/InstallationId"
        },
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        },
        "peer": {
          "$ref": "#/$defs/RecordId"
        },
        "tokenExpiresAt": {
          "$ref": "#/$defs/UnixSeconds"
        }
      },
      "required": [
        "installation",
        "peer",
        "organizationId",
        "enrollmentId",
        "tokenExpiresAt"
      ],
      "type": "object"
    },
    "EnrollmentId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "MachineConnectionRefusal": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknownMachine",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "enrollmentNotActive",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "superseded",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "machineInAnotherOrganization",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wrongClient",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "OrganizationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RecordId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "UnixSeconds": {
      "format": "int64",
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "machine": {
          "$ref": "#/$defs/AdmittedMachine"
        },
        "result": {
          "const": "admitted",
          "type": "string"
        }
      },
      "required": [
        "result",
        "machine"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/MachineConnectionRefusal"
        },
        "result": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "result",
        "reason"
      ],
      "type": "object"
    }
  ],
  "title": "MachineConnectionAdmission"
}
