{
  "$defs": {
    "AdmissionId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "MachineId": {
      "description": "The Router install's durable identity, shared with central.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "admissionId": {
          "$ref": "#/$defs/AdmissionId"
        },
        "kind": {
          "const": "admission",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "admissionId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "machine",
          "type": "string"
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        }
      },
      "required": [
        "kind",
        "machineId"
      ],
      "type": "object"
    }
  ],
  "title": "AdmissionRef"
}
