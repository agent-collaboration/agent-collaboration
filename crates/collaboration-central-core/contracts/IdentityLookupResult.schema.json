{
  "$defs": {
    "AbsolutePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^/[^\\u0000]*$",
      "type": "string",
      "x-maxUtf8Bytes": 4096
    },
    "AgentIsolation": {
      "additionalProperties": false,
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/IsolationInstanceId"
        },
        "kind": {
          "$ref": "#/$defs/IsolationKind"
        }
      },
      "required": [
        "kind",
        "instanceId"
      ],
      "type": "object"
    },
    "CommitId": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string",
      "x-maxUtf8Bytes": 64
    },
    "EndpointId": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 64
    },
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "IsolationInstanceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "IsolationKind": {
      "enum": [
        "host",
        "processSandbox",
        "container",
        "vm"
      ],
      "type": "string"
    },
    "LaunchContext": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelName"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepositoryLocator"
            },
            {
              "type": "null"
            }
          ]
        },
        "workingDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        }
      },
      "required": [
        "workingDirectory"
      ],
      "type": "object"
    },
    "MachineEnvironment": {
      "enum": [
        "physical",
        "cloudVm"
      ],
      "type": "string"
    },
    "ModelName": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "OrganizationStanding": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "result": {
              "const": "admitted",
              "type": "string"
            },
            "role": {
              "$ref": "#/$defs/StandingRole"
            }
          },
          "required": [
            "result",
            "role"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "result": {
              "const": "awaitingOwner",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "result": {
              "const": "notAdmitted",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "type": "object"
        }
      ]
    },
    "OwnerRefusal": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notOwner",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notFound",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "conflict",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "recordUnwritable",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "PersonId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ProjectId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/ResourceName"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "projectId",
        "name"
      ],
      "type": "object"
    },
    "RemoteStartId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RepositoryLocator": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "type": "string",
      "x-maxUtf8Bytes": 2048
    },
    "ResourceName": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?:[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)?$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "ServiceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "SessionEndpointRef": {
      "additionalProperties": false,
      "properties": {
        "endpointId": {
          "$ref": "#/$defs/EndpointId"
        },
        "serviceId": {
          "$ref": "#/$defs/ServiceId"
        }
      },
      "required": [
        "serviceId",
        "endpointId"
      ],
      "type": "object"
    },
    "SessionId": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "type": "string",
      "x-maxUtf8Bytes": 4096
    },
    "SessionRef": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/SessionEndpointRef"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "endpoint",
        "sessionId"
      ],
      "type": "object"
    },
    "StandingRole": {
      "enum": [
        "member",
        "owner"
      ],
      "type": "string"
    },
    "StartedBy": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "routerOperator",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "session",
              "type": "string"
            },
            "session": {
              "$ref": "#/$defs/SessionRef"
            }
          },
          "required": [
            "kind",
            "session"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "remoteSession",
              "type": "string"
            },
            "requestId": {
              "$ref": "#/$defs/RemoteStartId"
            },
            "session": {
              "$ref": "#/$defs/SessionRef"
            }
          },
          "required": [
            "kind",
            "session",
            "requestId"
          ],
          "type": "object"
        }
      ]
    },
    "UnixMillis": {
      "format": "int64",
      "type": "integer"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/ResourceName"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "personId": {
          "$ref": "#/$defs/PersonId"
        },
        "result": {
          "const": "person",
          "type": "string"
        },
        "standing": {
          "$ref": "#/$defs/OrganizationStanding"
        }
      },
      "required": [
        "result",
        "personId",
        "standing"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "isolation": {
          "$ref": "#/$defs/AgentIsolation"
        },
        "launchContext": {
          "$ref": "#/$defs/LaunchContext"
        },
        "machine": {
          "$ref": "#/$defs/InstallationId"
        },
        "machineEnvironment": {
          "$ref": "#/$defs/MachineEnvironment"
        },
        "project": {
          "$ref": "#/$defs/ProjectRef"
        },
        "result": {
          "const": "session",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "startedAt": {
          "$ref": "#/$defs/UnixMillis"
        },
        "startedBy": {
          "$ref": "#/$defs/StartedBy"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceRef"
        }
      },
      "required": [
        "result",
        "session",
        "machine",
        "project",
        "workspace",
        "isolation",
        "machineEnvironment",
        "launchContext",
        "startedBy",
        "startedAt"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "result": {
          "const": "unknown",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/OwnerRefusal"
        },
        "result": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "result",
        "reason"
      ],
      "type": "object"
    }
  ],
  "title": "IdentityLookupResult"
}
