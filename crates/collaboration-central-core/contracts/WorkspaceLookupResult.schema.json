{
  "$defs": {
    "AllowedMachineRow": {
      "additionalProperties": false,
      "properties": {
        "installation": {
          "$ref": "#/$defs/InstallationId"
        },
        "label": {
          "$ref": "#/$defs/MachineLabel"
        }
      },
      "required": [
        "installation",
        "label"
      ],
      "type": "object"
    },
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "type": "string",
      "x-maxUtf8Bytes": 36
    },
    "MachineLabel": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "OwnerRefusal": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notOwner",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notFound",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "conflict",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "recordUnwritable",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ResourceName": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-maxUtf8Bytes": 256
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/ResourceName"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "allowedMachines": {
          "items": {
            "$ref": "#/$defs/AllowedMachineRow"
          },
          "type": "array"
        },
        "result": {
          "const": "workspace",
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceRef"
        }
      },
      "required": [
        "result",
        "workspace",
        "allowedMachines"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "result": {
          "const": "unknown",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/OwnerRefusal"
        },
        "result": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "result",
        "reason"
      ],
      "type": "object"
    }
  ],
  "title": "WorkspaceLookupResult"
}
