{
  "$defs": {
    "EnrollmentId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "InstallationId": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])",
      "type": "string",
      "x-maxUtf8Bytes": 36
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "enrollment_id": {
          "$ref": "#/$defs/EnrollmentId"
        },
        "installation_id": {
          "$ref": "#/$defs/InstallationId"
        },
        "kind": {
          "const": "machine",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "installation_id",
        "enrollment_id"
      ],
      "type": "object"
    }
  ],
  "title": "MachinePrincipal"
}
