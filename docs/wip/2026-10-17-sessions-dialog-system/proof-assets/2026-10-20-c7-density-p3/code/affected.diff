+#[test]
+fn quota_list_unit_formatter_groups_values_at_the_typed_origin() {
+    let windows = [display_window(
+        V1_WEEKLY_WINDOW_SECONDS,
+        83,
+        NOW + 7 * 86400,
+        QuotaRunRateEstimate::unknown(),
+    )];
